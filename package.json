{
    "name": "nyx-dlp",
    "version": "3.0.5",
    "description": "Modern Electron GUI for yt-dlp, gallery-dl, M3U8 downloads and YouTube live archiving",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build:portable": "node build.js portable",
        "build:installer": "node build.js installer",
        "build:mac": "node build.js mac",
        "build:linux": "node build.js linux",
        "build:linux-cli": "node build.js linux-cli",
        "install-deps": "npm install"
    },
    "devDependencies": {
        "@electron/packager": "^20.0.0",
        "electron": "^28.3.3",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.nyxdlp.app",
        "productName": "nyx-dlp",
        "icon": "assets/icon.ico",
        "compression": "store",
        "directories": {
            "output": "dist/installer"
        },
        "extraResources": [
            {
                "from": "scripts",
                "to": "scripts"
            }
        ],
        "files": [
            "**/*",
            "!dist/**/*",
            "!scripts/**/*",
            "!*.md",
            "!**/__pycache__/**/*"
        ],
        "asar": false,
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "include": "build/installer.nsh"
        },
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "assets/icon.png",
            "category": "public.app-category.utilities"
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "assets/icon.png",
            "category": "Utility"
        }
    },
    "dependencies": {
        "koffi": "^3.1.2",
        "ws": "^8.21.0"
    }
}
