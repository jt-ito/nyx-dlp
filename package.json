{
  "name": "nyx-dlp",
  "version": "2.0.1",
  "description": "Modern Electron GUI for yt-dlp, gallery-dl, M3U8 downloads and YouTube live archiving",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:portable": "node build.js portable",
    "build:installer": "node build.js installer",
    "install-deps": "npm install"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nyxdlp.app",
    "productName": "nyx-dlp",
    "directories": {
      "output": "dist/installer"
    },
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts"
      }
    ],
    "files": [
      "**/*",
      "!dist/**/*",
      "!scripts/**/*",
      "!*.md",
      "!**/__pycache__/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.21.0"
  }
}
