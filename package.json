{
  "name": "nyx-dlp",
  "version": "1.0.0",
  "description": "Modern Electron GUI for yt-dlp, gallery-dl, M3U8 downloads and YouTube live archiving",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . \"nyx-dlp\" --platform=win32 --arch=x64 --out=dist --overwrite --extra-resource=scripts --ignore=\"(/node_modules|/dist|\\.md$|/__pycache__|/scripts)\"",
    "install-deps": "npm install"
  },
  "devDependencies": {
    "@electron/packager": "^19.1.0",
    "electron": "^28.0.0"
  }
}
